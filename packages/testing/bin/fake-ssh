#!/bin/sh
# A stand-in `ssh` (fake-ssh.ts beside this file, which says what it does), for SSH links in tests: $HUNTAWAY_NODE,
# else node on PATH.
self=$(readlink -f "$0" 2>/dev/null)
[ -n "$self" ] && [ -f "$self" ] || self=$(cd -P "$(dirname "$0")" && pwd)/$(basename "$0")
exec "${HUNTAWAY_NODE:-node}" --disable-warning=ExperimentalWarning "$(dirname "$self")/fake-ssh.ts" "$@"
