{
  // Checked on its own (`pnpm run typecheck` in apps/web) with no DOM, so that it runs in React Native as well as a browser.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    // src/protocol.ts is the server's threads/protocol.ts, by its path.
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["src"]
}
