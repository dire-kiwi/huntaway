#!/usr/bin/env python3
"""A stand-in `claude` for test servers (`scripts/test-server.sh --fake-claude`), for testing
runner, queue and merge logic without a model.

An agent run (`-p --output-format stream-json`) reads its first prompt, prints a system init,
one assistant message and a `result`, then exits. Title generation (`--output-format text`)
prints a title. Each call appends a JSON line (args, cwd, config dir, TMPDIR, prompt) to
$IA_FAKE_CLAUDE_LOG, if set (test-server.sh sets it to <data dir>/fake-claude.log).

Set these in the server's environment (before test-server.sh, which keeps them for `restart`):
  IA_FAKE_CLAUDE_SLEEP   seconds to wait before replying (to catch a run while it's running)
  IA_FAKE_CLAUDE_TEXT    the assistant's reply (default "Fake reply to: <prompt>")
  IA_FAKE_CLAUDE_RESULT  the result's subtype (default success; anything else is an error)
  IA_FAKE_CLAUDE_EXIT    exit status (default 0)
  IA_FAKE_CLAUDE_TITLE   the title that title generation prints (default "Fake title")
  IA_FAKE_CLAUDE_LIMIT   seconds until the usage limit resets (default 7200) for a prompt containing
                         "out-of-usage", which is refused for the usage limit as Claude Code does
  IA_FAKE_CLAUDE_USAGE   "out" refuses every run that way; "extra" (or a prompt containing
                         "on-extra-usage") reports the limit as used up but carries on, on extra usage
  IA_FAKE_CLAUDE_WINDOW  seconds a 5-hour window lasts: each stream-json run reports its window, which
                         starts with the first run after the last one ended (kept in a file beside the log)
"""
import json
import os
import select
import sys
import time
import uuid

args = sys.argv[1:]


def opt(name):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None


def read_prompt():
    # stream-json input is one JSON line per message; text input is all of stdin.
    if not select.select([sys.stdin], [], [], 10)[0]:
        return ""
    if opt("--input-format") == "stream-json":
        line = sys.stdin.readline()
        try:
            content = json.loads(line)["message"]["content"]
        except (ValueError, KeyError, TypeError):
            return line.strip()
        if isinstance(content, list):
            return "\n".join(b.get("text", "") for b in content if isinstance(b, dict))
        return str(content)
    return sys.stdin.read()


def emit(v):
    print(json.dumps(v), flush=True)


if "--version" in args:
    print("0.0.0 (fake-claude)")
    sys.exit(0)

prompt = read_prompt()
log = os.environ.get("IA_FAKE_CLAUDE_LOG")
if log:
    entry = {"time": time.time(), "args": args, "cwd": os.getcwd(), "config_dir": os.environ.get("CLAUDE_CONFIG_DIR"), "tmpdir": os.environ.get("TMPDIR"), "prompt": prompt}
    with open(log, "a") as f:
        f.write(json.dumps(entry) + "\n")

if opt("--output-format") == "text":
    print(os.environ.get("IA_FAKE_CLAUDE_TITLE", "Fake title"))
    sys.exit(0)

session = opt("--resume") or str(uuid.uuid4())
model = opt("--model") or "fake"
emit({"type": "system", "subtype": "init", "session_id": session, "model": model, "cwd": os.getcwd(), "tools": []})
time.sleep(float(os.environ.get("IA_FAKE_CLAUDE_SLEEP", "0")))
usage = os.environ.get("IA_FAKE_CLAUDE_USAGE") or ("extra" if "on-extra-usage" in prompt else "out" if "out-of-usage" in prompt else "")
window = os.environ.get("IA_FAKE_CLAUDE_WINDOW")
if window and not usage:
    # The plan's 5-hour window, as Claude Code reports it on each turn.
    state = os.path.join(os.path.dirname(log or os.path.abspath(".")), "fake-claude-window")
    try:
        resets = int(open(state).read())
    except (OSError, ValueError):
        resets = 0
    if resets <= time.time():
        resets = int(time.time() + float(window))
        with open(state, "w") as f:
            f.write(str(resets))
    info = {"status": "allowed", "resetsAt": resets, "rateLimitType": "five_hour", "overageStatus": "rejected", "isUsingOverage": False,
            "unifiedWindows": {"five_hour": {"utilization": 0.01, "resetsAt": resets, "status": "allowed"}}}
    emit({"type": "rate_limit_event", "rate_limit_info": info, "session_id": session})
if usage == "extra":
    # What a plan with extra usage reports on each turn past its limit, which goes on.
    resets = int(time.time() + float(os.environ.get("IA_FAKE_CLAUDE_LIMIT", "7200")))
    info = {"status": "rejected", "resetsAt": resets, "rateLimitType": "five_hour", "overageStatus": "allowed", "isUsingOverage": True,
            "unifiedWindows": {"five_hour": {"utilization": 1, "resetsAt": resets, "status": "rejected"}}}
    emit({"type": "rate_limit_event", "rate_limit_info": info, "session_id": session})
if usage == "out":
    # What Claude Code prints when the plan's 5-hour limit refuses a turn.
    resets = int(time.time() + float(os.environ.get("IA_FAKE_CLAUDE_LIMIT", "7200")))
    info = {"status": "rejected", "resetsAt": resets, "rateLimitType": "five_hour", "overageStatus": "rejected", "isUsingOverage": False}
    windows = {"five_hour": {"utilization": 1, "resetsAt": resets, "status": "rejected"}, "seven_day": {"utilization": 0.62, "resetsAt": resets + 86400, "status": "allowed"}}
    emit({"type": "rate_limit_event", "rate_limit_info": {**info, "unifiedWindows": windows}, "session_id": session})
    text = "You've hit your 5-hour limit · resets " + time.strftime("%-I:%M%p", time.localtime(resets)).lower()
    emit({"type": "assistant", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None, "error": "rate_limit",
          "api_error_status": 429, "api_error": "usage_limit_reached", "api_error_params": {"rate_limit_info": info},
          "message": {"id": str(uuid.uuid4()), "role": "assistant", "model": "<synthetic>", "content": [{"type": "text", "text": text}]}})
    emit({"type": "result", "subtype": "success", "is_error": True, "api_error_status": 429, "api_error": "usage_limit_reached",
          "result": text, "session_id": session, "duration_ms": 1, "num_turns": 1, "total_cost_usd": 0})
    sys.exit(0)
text = os.environ.get("IA_FAKE_CLAUDE_TEXT") or "Fake reply to: " + prompt.strip()[:200]
emit({
    "type": "assistant",
    "session_id": session,
    "uuid": str(uuid.uuid4()),
    "parent_tool_use_id": None,
    "message": {"id": "msg_" + uuid.uuid4().hex, "role": "assistant", "model": model, "content": [{"type": "text", "text": text}],
                "usage": {"input_tokens": 1, "output_tokens": 1}},
})
subtype = os.environ.get("IA_FAKE_CLAUDE_RESULT", "success")
emit({
    "type": "result",
    "subtype": subtype,
    "is_error": subtype != "success",
    "result": text,
    "session_id": session,
    "duration_ms": 1,
    "num_turns": 1,
    "total_cost_usd": 0,
})
sys.exit(int(os.environ.get("IA_FAKE_CLAUDE_EXIT", "0")))
