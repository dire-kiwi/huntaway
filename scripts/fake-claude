#!/usr/bin/env python3
"""A stand-in `claude` for test servers (`scripts/test-server.sh --fake-claude`), for testing
runner, queue and merge logic without a model.

An agent run (`-p --output-format stream-json`) reads its first prompt, prints a system init,
one assistant message and a `result`, then exits. Title generation (`--output-format json`)
prints a `result` with the title and the tokens it took (`--output-format text`, a bare title). Each call appends a JSON line (args, cwd, config dir, TMPDIR, prompt) to
$IA_FAKE_CLAUDE_LOG, if set (test-server.sh sets it to <data dir>/fake-claude.log).

Set these in the server's environment (before test-server.sh, which keeps them for `restart`):
  IA_FAKE_CLAUDE_SLEEP   seconds to wait before replying (to catch a run while it's running)
  IA_FAKE_CLAUDE_TEXT    the assistant's reply (default "Fake reply to: <prompt>")
  IA_FAKE_CLAUDE_RESULT  the result's subtype (default success; anything else is an error)
  IA_FAKE_CLAUDE_EXIT    exit status (default 0)
  IA_FAKE_CLAUDE_TITLE   the title that title generation prints (default "Fake title")
  IA_FAKE_CLAUDE_LIMIT   seconds until the usage limit resets (default 7200) for a prompt containing
                         "out-of-usage", which is refused for the usage limit as Claude Code does
  IA_FAKE_CLAUDE_USAGE   "out" refuses every run that way; "extra" (or a prompt containing
                         "on-extra-usage") reports the limit as used up but carries on, on extra usage
  IA_FAKE_CLAUDE_WINDOW  seconds a 5-hour window lasts: each stream-json run reports its window, which
                         starts with the first run after the last one ended (kept in a file beside the log);
                         that first run reports the window that ended, as Claude Code does
  IA_FAKE_CLAUDE_COST    what each stream-json run costs (default 0): its result reports its session's total,
                         which goes on over the runs that resume the session (kept in a file beside the log),
                         as Claude Code's `total_cost_usd` does

A run whose stream-json input starts with a control request (agent-threads' driver, see
server/src/threads/engine.rs) is a session instead: it answers control requests, takes each user message
as a turn (replayed, then the reply and a `result` after IA_FAKE_CLAUDE_SLEEP), takes messages sent during
a turn into it (the reply names them), ends a turn as interrupted on an `interrupt` request, and exits when
its input closes. A message containing "fake-ask-permission" asks permission (`can_use_tool`) for a Bash
call first, and the reply says what the answer was.
"""
import json
import os
import select
import sys
import time
import uuid

args = sys.argv[1:]


def opt(name):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None


def read_prompt():
    # stream-json input is one JSON line per message; text input is all of stdin.
    if opt("--input-format") == "stream-json":
        line = _first_line or ""
        try:
            content = json.loads(line)["message"]["content"]
        except (ValueError, KeyError, TypeError):
            return line.strip()
        if isinstance(content, list):
            return "\n".join(b.get("text", "") for b in content if isinstance(b, dict))
        return str(content)
    if not select.select([sys.stdin], [], [], 10)[0]:
        return ""
    return sys.stdin.read()


def emit(v):
    print(json.dumps(v), flush=True)


if "--version" in args:
    print("0.0.0 (fake-claude)")
    sys.exit(0)


def log_call(prompt):
    log = os.environ.get("IA_FAKE_CLAUDE_LOG")
    if log:
        entry = {"time": time.time(), "args": args, "cwd": os.getcwd(), "config_dir": os.environ.get("CLAUDE_CONFIG_DIR"), "tmpdir": os.environ.get("TMPDIR"),
                 "prompt": prompt, "session_mode": True}
        with open(log, "a") as f:
            f.write(json.dumps(entry) + "\n")


def message_text(msg):
    content = msg.get("message", {}).get("content", "")
    if isinstance(content, list):
        return "\n".join(b.get("text", "") for b in content if isinstance(b, dict))
    return str(content)


def session_mode(first):
    """agent-threads' driver: control requests and a turn for each user message, until stdin closes."""
    session = opt("--resume") or str(uuid.uuid4())
    model = opt("--model") or "fake"
    pending = [first]
    started = [False]

    def read(timeout):
        if pending:
            return pending.pop(0)
        if not select.select([sys.stdin], [], [], timeout)[0]:
            return None
        line = sys.stdin.readline()
        if not line:
            sys.exit(int(os.environ.get("IA_FAKE_CLAUDE_EXIT", "0")))
        try:
            return json.loads(line)
        except ValueError:
            return None

    def control(m, response=None):
        emit({"type": "control_response", "response": {"subtype": "success", "request_id": m.get("request_id"), "response": response or {}}})

    def replay(m):
        emit({"type": "user", "message": m.get("message"), "session_id": session, "parent_tool_use_id": None, "uuid": m.get("uuid") or str(uuid.uuid4()),
              "isReplay": True})

    def result(subtype, text):
        emit({"type": "result", "subtype": subtype, "is_error": subtype != "success", "result": text, "session_id": session, "duration_ms": 1, "num_turns": 1,
              "total_cost_usd": float(os.environ.get("IA_FAKE_CLAUDE_COST", "0"))})

    def turn(m):
        prompt = message_text(m)
        log_call(prompt)
        if not started[0]:
            started[0] = True
            emit({"type": "system", "subtype": "init", "session_id": session, "model": model, "cwd": os.getcwd(), "tools": [], "skills": []})
        replay(m)
        taken = []
        answer = None
        if "fake-ask-permission" in prompt:
            ask = str(uuid.uuid4())
            tool = "toolu_" + uuid.uuid4().hex
            emit({"type": "assistant", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None,
                  "message": {"id": "msg_" + uuid.uuid4().hex, "role": "assistant", "model": model,
                              "content": [{"type": "tool_use", "id": tool, "name": "Bash", "input": {"command": "echo fake"}}]}})
            emit({"type": "control_request", "request_id": ask, "request": {"subtype": "can_use_tool", "tool_name": "Bash", "input": {"command": "echo fake"},
                                                                          "tool_use_id": tool}})
            while answer is None:
                r = read(None)
                if r is None:
                    continue
                if r.get("type") == "control_response" and r.get("response", {}).get("request_id") == ask:
                    answer = r["response"].get("response", {}).get("behavior", "deny")
                elif r.get("type") == "control_request" and r.get("request", {}).get("subtype") == "interrupt":
                    control(r)
                    result("error_during_execution", "interrupted")
                    return
                elif r.get("type") == "control_request":
                    control(r)
                elif r.get("type") == "user":
                    replay(r)
                    taken.append(message_text(r))
            emit({"type": "user", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None,
                  "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": tool, "content": "fake" if answer == "allow" else "denied",
                                                            "is_error": answer != "allow"}]}})
        deadline = time.time() + float(os.environ.get("IA_FAKE_CLAUDE_SLEEP", "0"))
        while True:
            r = read(max(0, deadline - time.time()))
            if r is None:
                if time.time() >= deadline:
                    break
                continue
            if r.get("type") == "control_request" and r.get("request", {}).get("subtype") == "interrupt":
                control(r, {"still_queued": []})
                emit({"type": "user", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None,
                      "message": {"role": "user", "content": [{"type": "text", "text": "[Request interrupted by user]"}]}})
                result("error_during_execution", "interrupted")
                return
            if r.get("type") == "control_request":
                control(r)
            elif r.get("type") == "user":
                # Taken into the turn as Claude Code takes a message sent while it works.
                replay(r)
                taken.append(message_text(r))
        text = os.environ.get("IA_FAKE_CLAUDE_TEXT") or "Fake reply to: " + prompt.strip()[:200]
        if answer:
            text += " (permission: " + answer + ")"
        if taken:
            text += " (also took in: " + " | ".join(t.strip()[:100] for t in taken) + ")"
        emit({"type": "assistant", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None,
              "message": {"id": "msg_" + uuid.uuid4().hex, "role": "assistant", "model": model, "content": [{"type": "text", "text": text}],
                          "usage": {"input_tokens": 1, "output_tokens": 1}}})
        subtype = os.environ.get("IA_FAKE_CLAUDE_RESULT", "success")
        result(subtype, text)

    while True:
        m = read(None)
        if m is None:
            continue
        if m.get("type") == "control_request":
            sub = m.get("request", {}).get("subtype")
            control(m, {"commands": [], "models": []} if sub == "initialize" else {})
        elif m.get("type") == "user":
            turn(m)


# agent-threads' driver starts with a control request (initialize) rather than a message.
if opt("--input-format") == "stream-json" and select.select([sys.stdin], [], [], 10)[0]:
    first_line = sys.stdin.readline()
    try:
        first = json.loads(first_line)
    except ValueError:
        first = None
    if isinstance(first, dict) and first.get("type") == "control_request":
        session_mode(first)
    _first_line = first_line
else:
    _first_line = None

prompt = read_prompt()
log = os.environ.get("IA_FAKE_CLAUDE_LOG")
if log:
    entry = {"time": time.time(), "args": args, "cwd": os.getcwd(), "config_dir": os.environ.get("CLAUDE_CONFIG_DIR"), "tmpdir": os.environ.get("TMPDIR"), "prompt": prompt}
    with open(log, "a") as f:
        f.write(json.dumps(entry) + "\n")

if opt("--output-format") in ("text", "json"):
    title = os.environ.get("IA_FAKE_CLAUDE_TITLE", "Fake title")
    if opt("--output-format") == "text":
        print(title)
    else:
        # Title generation's result, with the tokens it took, as Claude Code reports them.
        usage = {"claude-haiku-fake": {"inputTokens": 2, "outputTokens": 5, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 600, "costUSD": 0.0002}}
        emit({"type": "result", "subtype": "success", "is_error": False, "result": title, "session_id": str(uuid.uuid4()), "total_cost_usd": 0.0002,
              "modelUsage": usage})
    sys.exit(0)

session = opt("--resume") or str(uuid.uuid4())
model = opt("--model") or "fake"
emit({"type": "system", "subtype": "init", "session_id": session, "model": model, "cwd": os.getcwd(), "tools": []})
time.sleep(float(os.environ.get("IA_FAKE_CLAUDE_SLEEP", "0")))
usage = os.environ.get("IA_FAKE_CLAUDE_USAGE") or ("extra" if "on-extra-usage" in prompt else "out" if "out-of-usage" in prompt else "")
window = os.environ.get("IA_FAKE_CLAUDE_WINDOW")
if window and not usage:
    # The plan's 5-hour window, as Claude Code reports it on each turn.
    state = os.path.join(os.path.dirname(log or os.path.abspath(".")), "fake-claude-window")
    try:
        resets = int(open(state).read())
    except (OSError, ValueError):
        resets = 0
    windows = {"seven_day": {"utilization": 0.3, "resetsAt": int(time.time() + 86400), "status": "allowed"}}
    if resets <= time.time():
        # As Claude Code does, the first run after a window ends reports the one that ended, and
        # leaves it out of unifiedWindows; the next run reports the new one.
        old, resets = resets, int(time.time() + float(window))
        with open(state, "w") as f:
            f.write(str(resets))
    else:
        old = None
        windows["five_hour"] = {"utilization": 0.01, "resetsAt": resets, "status": "allowed"}
    info = {"status": "allowed", "resetsAt": old or resets, "rateLimitType": "five_hour", "overageStatus": "rejected", "isUsingOverage": False,
            "unifiedWindows": windows}
    emit({"type": "rate_limit_event", "rate_limit_info": info, "session_id": session})
if usage == "extra":
    # What a plan with extra usage reports on each turn past its limit, which goes on.
    resets = int(time.time() + float(os.environ.get("IA_FAKE_CLAUDE_LIMIT", "7200")))
    info = {"status": "rejected", "resetsAt": resets, "rateLimitType": "five_hour", "overageStatus": "allowed", "isUsingOverage": True,
            "unifiedWindows": {"five_hour": {"utilization": 1, "resetsAt": resets, "status": "rejected"}}}
    emit({"type": "rate_limit_event", "rate_limit_info": info, "session_id": session})
if usage == "out":
    # What Claude Code prints when the plan's 5-hour limit refuses a turn.
    resets = int(time.time() + float(os.environ.get("IA_FAKE_CLAUDE_LIMIT", "7200")))
    info = {"status": "rejected", "resetsAt": resets, "rateLimitType": "five_hour", "overageStatus": "rejected", "isUsingOverage": False}
    windows = {"five_hour": {"utilization": 1, "resetsAt": resets, "status": "rejected"}, "seven_day": {"utilization": 0.62, "resetsAt": resets + 86400, "status": "allowed"}}
    emit({"type": "rate_limit_event", "rate_limit_info": {**info, "unifiedWindows": windows}, "session_id": session})
    text = "You've hit your 5-hour limit · resets " + time.strftime("%-I:%M%p", time.localtime(resets)).lower()
    emit({"type": "assistant", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None, "error": "rate_limit",
          "api_error_status": 429, "api_error": "usage_limit_reached", "api_error_params": {"rate_limit_info": info},
          "message": {"id": str(uuid.uuid4()), "role": "assistant", "model": "<synthetic>", "content": [{"type": "text", "text": text}]}})
    emit({"type": "result", "subtype": "success", "is_error": True, "api_error_status": 429, "api_error": "usage_limit_reached",
          "result": text, "session_id": session, "duration_ms": 1, "num_turns": 1, "total_cost_usd": 0})
    sys.exit(0)
text = os.environ.get("IA_FAKE_CLAUDE_TEXT") or "Fake reply to: " + prompt.strip()[:200]
emit({
    "type": "assistant",
    "session_id": session,
    "uuid": str(uuid.uuid4()),
    "parent_tool_use_id": None,
    "message": {"id": "msg_" + uuid.uuid4().hex, "role": "assistant", "model": model, "content": [{"type": "text", "text": text}],
                "usage": {"input_tokens": 1, "output_tokens": 1}},
})
subtype = os.environ.get("IA_FAKE_CLAUDE_RESULT", "success")
total = float(os.environ.get("IA_FAKE_CLAUDE_COST", "0"))
if total and log:
    costs = os.path.join(os.path.dirname(log), "fake-claude-costs.json")
    try:
        with open(costs) as f:
            sessions = json.load(f)
    except (OSError, ValueError):
        sessions = {}
    total += sessions.get(session, 0)
    sessions[session] = total
    with open(costs, "w") as f:
        json.dump(sessions, f)
emit({
    "type": "result",
    "subtype": subtype,
    "is_error": subtype != "success",
    "result": text,
    "session_id": session,
    "duration_ms": 1,
    "num_turns": 1,
    "total_cost_usd": total,
    "modelUsage": {model: {"inputTokens": 1, "outputTokens": 1, "costUSD": total}} if total else {},
})
sys.exit(int(os.environ.get("IA_FAKE_CLAUDE_EXIT", "0")))
