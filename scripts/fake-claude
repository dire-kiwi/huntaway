#!/usr/bin/env python3
"""A stand-in `claude` for test servers (`scripts/test-server.sh --fake-claude`), for testing
runner, queue and merge logic without a model.

An agent run (`-p --output-format stream-json`) reads its first prompt, prints a system init,
one assistant message and a `result`, then exits. Title generation (`--output-format json`)
prints a `result` with the title and the tokens it took (`--output-format text`, a bare title). Each call appends a JSON line (args, cwd, config dir, TMPDIR, prompt) to
$IA_FAKE_CLAUDE_LOG, if set (test-server.sh sets it to <data dir>/fake-claude.log).

Set these in the server's environment (before test-server.sh, which keeps them for `restart`):
  IA_FAKE_CLAUDE_SLEEP   seconds to wait before replying (to catch a run while it's running)
  IA_FAKE_CLAUDE_TEXT    the assistant's reply (default "Fake reply to: <prompt>")
  IA_FAKE_CLAUDE_RESULT  the result's subtype (default success; anything else is an error)
  IA_FAKE_CLAUDE_EXIT    exit status (default 0)
  IA_FAKE_CLAUDE_TITLE   the title that title generation prints (default "Fake title")
  IA_FAKE_CLAUDE_LIMIT   seconds until the usage limit resets (default 7200) for a prompt containing
                         "out-of-usage", which is refused for the usage limit as Claude Code does
  IA_FAKE_CLAUDE_USAGE   "out" refuses every run that way; "extra" (or a prompt containing
                         "on-extra-usage") reports the limit as used up but carries on, on extra usage
  IA_FAKE_CLAUDE_WINDOW  seconds a 5-hour window lasts: each stream-json run reports its window, which
                         starts with the first run after the last one ended (kept in a file beside the log);
                         that first run reports the window that ended, as Claude Code does
  IA_FAKE_CLAUDE_COST    what each stream-json run costs (default 0): its result reports its session's total,
                         which goes on over the runs that resume the session (kept in a file beside the log),
                         as Claude Code's `total_cost_usd` does
  IA_FAKE_CLAUDE_LOGIN   "out" answers every run as Claude Code does in a config folder with no login
  IA_FAKE_CLAUDE_SESSIONS  "1" keeps the sessions each config folder (CLAUDE_CONFIG_DIR) has, in a file
                         beside the log, and fails a --resume of one the folder hasn't, as Claude Code does

Messages steered into a run (stream-json lines on stdin after the prompt, while it sleeps) are echoed back as
Claude Code does (`isReplay`), and answered in its reply. A run started with `--permission-prompt-tool stdio` asks
for permission as Claude Code does, with a `can_use_tool` control request on stdout, for each of these in its prompt:
"fake-ask-permission" (a Bash call), "fake-ask-question" (AskUserQuestion) and "fake-ask-plan" (ExitPlanMode). It waits
for each `control_response` on stdin (taking in messages sent meanwhile), and its reply says what each answer was
("permission Bash: allow", with a question's answers or a plan's new mode, or "deny: <message>"). An `interrupt`
meanwhile cancels the request (`control_cancel_request`) and ends the turn as interrupted. A `/compact` prompt prints a compact_boundary. A prompt
containing "fake-subagent" runs a subagent (a Task call, with a Read inside it), and streams its reply's text
(stream_event deltas) before the assistant message.
"""
import json
import os
import select
import sys
import time
import uuid

args = sys.argv[1:]


def opt(name):
    return args[args.index(name) + 1] if name in args and args.index(name) + 1 < len(args) else None


def read_prompt():
    # stream-json input is one JSON line per message; text input is all of stdin.
    if not select.select([sys.stdin], [], [], 10)[0]:
        return ""
    if opt("--input-format") == "stream-json":
        line = sys.stdin.readline()
        try:
            content = json.loads(line)["message"]["content"]
        except (ValueError, KeyError, TypeError):
            return line.strip()
        if isinstance(content, list):
            return "\n".join(b.get("text", "") for b in content if isinstance(b, dict))
        return str(content)
    return sys.stdin.read()


def emit(v):
    print(json.dumps(v), flush=True)


if "--version" in args:
    print("0.0.0 (fake-claude)")
    sys.exit(0)

prompt = read_prompt()
steered = []
log = os.environ.get("IA_FAKE_CLAUDE_LOG")
if log:
    entry = {"time": time.time(), "args": args, "cwd": os.getcwd(), "config_dir": os.environ.get("CLAUDE_CONFIG_DIR"), "tmpdir": os.environ.get("TMPDIR"), "prompt": prompt}
    with open(log, "a") as f:
        f.write(json.dumps(entry) + "\n")

if opt("--output-format") in ("text", "json"):
    title = os.environ.get("IA_FAKE_CLAUDE_TITLE", "Fake title")
    if opt("--output-format") == "text":
        print(title)
    else:
        # Title generation's result, with the tokens it took, as Claude Code reports them.
        usage = {"claude-haiku-fake": {"inputTokens": 2, "outputTokens": 5, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 600, "costUSD": 0.0002}}
        emit({"type": "result", "subtype": "success", "is_error": False, "result": title, "session_id": str(uuid.uuid4()), "total_cost_usd": 0.0002,
              "modelUsage": usage})
    sys.exit(0)

session = opt("--resume") or str(uuid.uuid4())
model = opt("--model") or "fake"
if os.environ.get("IA_FAKE_CLAUDE_SESSIONS") == "1":
    # Each config folder's sessions, as Claude Code keeps them in its projects folder.
    known_file = os.path.join(os.path.dirname(log or os.path.abspath(".")), "fake-claude-sessions")
    try:
        with open(known_file) as f:
            known = json.load(f)
    except (OSError, ValueError):
        known = {}
    folder = os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")
    if opt("--resume") and session not in known.get(folder, []):
        emit({"type": "result", "subtype": "error_during_execution", "is_error": True, "duration_ms": 0, "duration_api_ms": 0, "num_turns": 0,
              "session_id": session, "total_cost_usd": 0, "errors": ["No conversation found with session ID: " + session]})
        sys.stderr.write("No conversation found with session ID: " + session + "\n")
        sys.exit(1)
    known.setdefault(folder, [])
    if session not in known[folder]:
        known[folder].append(session)
    with open(known_file, "w") as f:
        json.dump(known, f)
emit({"type": "system", "subtype": "init", "session_id": session, "model": model, "cwd": os.getcwd(), "tools": []})
time.sleep(float(os.environ.get("IA_FAKE_CLAUDE_SLEEP", "0")))
if opt("--input-format") == "stream-json":
    # What was steered into the turn while it slept, echoed back as Claude Code does when it takes it in.
    while select.select([sys.stdin], [], [], 0)[0]:
        line = sys.stdin.readline()
        if not line:
            break
        try:
            m = json.loads(line)
        except ValueError:
            continue
        if m.get("type") == "user":
            emit({**m, "isReplay": True, "session_id": session})
            c = m.get("message", {}).get("content")
            steered.append(c if isinstance(c, str) else " ".join(b.get("text", "") for b in c or [] if isinstance(b, dict)))
asks = [m for m in ("fake-ask-permission", "fake-ask-question", "fake-ask-plan") if m in prompt] if opt("--permission-prompt-tool") == "stdio" else []
answers = []
for marker in asks:
    # Asked as Claude Code asks with --permission-prompt-tool stdio: the call, then a control request for it.
    name, tool_input = "Bash", {"command": "echo fake", "description": "Say fake"}
    if marker == "fake-ask-question":
        name = "AskUserQuestion"
        tool_input = {"questions": [{"question": "Which one?", "header": "Pick", "multiSelect": False, "options": [{"label": "a"}, {"label": "b"}]}]}
    elif marker == "fake-ask-plan":
        name, tool_input = "ExitPlanMode", {"plan": "# Plan: fake things\n\n1. Do a fake thing"}
    tool, ask = "toolu_" + uuid.uuid4().hex[:12], str(uuid.uuid4())
    emit({"type": "assistant", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None,
          "message": {"id": "msg_" + uuid.uuid4().hex, "role": "assistant", "model": model, "content": [{"type": "tool_use", "id": tool, "name": name, "input": tool_input}]}})
    emit({"type": "control_request", "request_id": ask,
          "request": {"subtype": "can_use_tool", "tool_name": name, "input": tool_input, "tool_use_id": tool, "permission_suggestions": []}})
    answer = None
    while answer is None:
        line = sys.stdin.readline()
        if not line:
            sys.exit(1)
        try:
            m = json.loads(line)
        except ValueError:
            continue
        if m.get("type") == "control_response" and m.get("response", {}).get("request_id") == ask:
            answer = m["response"].get("response") or {"behavior": "deny", "message": m["response"].get("error", "error")}
        elif m.get("type") == "control_request" and m.get("request", {}).get("subtype") == "interrupt":
            emit({"type": "control_cancel_request", "request_id": ask})
            emit({"type": "control_response", "response": {"subtype": "success", "request_id": m.get("request_id"), "response": {}}})
            emit({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": "interrupted", "session_id": session,
                  "duration_ms": 1, "num_turns": 1, "total_cost_usd": 0})
            while sys.stdin.readline():
                pass
            sys.exit(0)
        elif m.get("type") == "user":
            emit({**m, "isReplay": True, "session_id": session})
            c = m.get("message", {}).get("content")
            steered.append(c if isinstance(c, str) else " ".join(b.get("text", "") for b in c or [] if isinstance(b, dict)))
    allowed = answer.get("behavior") == "allow"
    said = "permission " + name + ": " + ("allow" if allowed else "deny: " + str(answer.get("message")))
    if allowed and name == "AskUserQuestion":
        said += " " + json.dumps((answer.get("updatedInput") or {}).get("answers"))
    if allowed and answer.get("updatedPermissions"):
        said += " " + json.dumps(answer["updatedPermissions"])
    answers.append(said)
    emit({"type": "user", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None,
          "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": tool, "content": "fake" if allowed else str(answer.get("message")),
                                                    "is_error": not allowed}]}})
if prompt.strip() == "/compact":
    emit({"type": "system", "subtype": "compact_boundary", "session_id": session, "compact_metadata": {"trigger": "manual", "pre_tokens": 1234}})
if "fake-subagent" in prompt:
    # A subagent (the Task tool), which reads a file, then ends; its call's result is what it found.
    call, read = "toolu_" + uuid.uuid4().hex[:12], "toolu_" + uuid.uuid4().hex[:12]
    say = lambda content, parent=None: emit({"type": "assistant", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": parent,
                                             "message": {"id": "msg_" + uuid.uuid4().hex, "role": "assistant", "model": model, "content": content}})
    result = lambda id, text, parent=None: emit({"type": "user", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": parent,
                                                  "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": id, "content": text}]}})
    say([{"type": "tool_use", "id": call, "name": "Task", "input": {"description": "Look around", "prompt": "Read the README", "subagent_type": "general-purpose"}}])
    emit({"type": "system", "subtype": "task_started", "task_id": "job_" + call, "tool_use_id": call, "description": "Look around", "session_id": session})
    say([{"type": "tool_use", "id": read, "name": "Read", "input": {"file_path": "README.md"}}], call)
    result(read, "# Readme", call)
    emit({"type": "system", "subtype": "task_notification", "task_id": "job_" + call, "tool_use_id": call, "status": "completed", "session_id": session})
    result(call, "It has a README.")
usage = os.environ.get("IA_FAKE_CLAUDE_USAGE") or ("extra" if "on-extra-usage" in prompt else "out" if "out-of-usage" in prompt else "")
window = os.environ.get("IA_FAKE_CLAUDE_WINDOW")
if window and not usage:
    # The plan's 5-hour window, as Claude Code reports it on each turn.
    state = os.path.join(os.path.dirname(log or os.path.abspath(".")), "fake-claude-window")
    try:
        resets = int(open(state).read())
    except (OSError, ValueError):
        resets = 0
    windows = {"seven_day": {"utilization": 0.3, "resetsAt": int(time.time() + 86400), "status": "allowed"}}
    if resets <= time.time():
        # As Claude Code does, the first run after a window ends reports the one that ended, and
        # leaves it out of unifiedWindows; the next run reports the new one.
        old, resets = resets, int(time.time() + float(window))
        with open(state, "w") as f:
            f.write(str(resets))
    else:
        old = None
        windows["five_hour"] = {"utilization": 0.01, "resetsAt": resets, "status": "allowed"}
    info = {"status": "allowed", "resetsAt": old or resets, "rateLimitType": "five_hour", "overageStatus": "rejected", "isUsingOverage": False,
            "unifiedWindows": windows}
    emit({"type": "rate_limit_event", "rate_limit_info": info, "session_id": session})
if usage == "extra":
    # What a plan with extra usage reports on each turn past its limit, which goes on.
    resets = int(time.time() + float(os.environ.get("IA_FAKE_CLAUDE_LIMIT", "7200")))
    info = {"status": "rejected", "resetsAt": resets, "rateLimitType": "five_hour", "overageStatus": "allowed", "isUsingOverage": True,
            "unifiedWindows": {"five_hour": {"utilization": 1, "resetsAt": resets, "status": "rejected"}}}
    emit({"type": "rate_limit_event", "rate_limit_info": info, "session_id": session})
if os.environ.get("IA_FAKE_CLAUDE_LOGIN") == "out":
    # What Claude Code prints in a config folder with no login: the session is started, and never reaches the API.
    text = "Not logged in · Please run /login"
    emit({"type": "assistant", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None, "error": "authentication_failed",
          "message": {"id": str(uuid.uuid4()), "role": "assistant", "model": "<synthetic>", "content": [{"type": "text", "text": text}]}})
    emit({"type": "result", "subtype": "success", "is_error": True, "result": text, "session_id": session, "duration_ms": 50, "duration_api_ms": 0,
          "num_turns": 1, "total_cost_usd": 0, "terminal_reason": "api_error"})
    sys.exit(1)
if usage == "out":
    # What Claude Code prints when the plan's 5-hour limit refuses a turn.
    resets = int(time.time() + float(os.environ.get("IA_FAKE_CLAUDE_LIMIT", "7200")))
    info = {"status": "rejected", "resetsAt": resets, "rateLimitType": "five_hour", "overageStatus": "rejected", "isUsingOverage": False}
    windows = {"five_hour": {"utilization": 1, "resetsAt": resets, "status": "rejected"}, "seven_day": {"utilization": 0.62, "resetsAt": resets + 86400, "status": "allowed"}}
    emit({"type": "rate_limit_event", "rate_limit_info": {**info, "unifiedWindows": windows}, "session_id": session})
    text = "You've hit your 5-hour limit · resets " + time.strftime("%-I:%M%p", time.localtime(resets)).lower()
    emit({"type": "assistant", "session_id": session, "uuid": str(uuid.uuid4()), "parent_tool_use_id": None, "error": "rate_limit",
          "api_error_status": 429, "api_error": "usage_limit_reached", "api_error_params": {"rate_limit_info": info},
          "message": {"id": str(uuid.uuid4()), "role": "assistant", "model": "<synthetic>", "content": [{"type": "text", "text": text}]}})
    emit({"type": "result", "subtype": "success", "is_error": True, "api_error_status": 429, "api_error": "usage_limit_reached",
          "result": text, "session_id": session, "duration_ms": 1, "num_turns": 1, "total_cost_usd": 0})
    sys.exit(0)
text = os.environ.get("IA_FAKE_CLAUDE_TEXT") or "Fake reply to: " + prompt.strip()[:200]
if steered:
    text += " (and to: " + "; ".join(steered)[:200] + ")"
if answers:
    text += " (" + "; ".join(answers) + ")"
if "fake-subagent" in prompt:
    emit({"type": "stream_event", "session_id": session, "parent_tool_use_id": None, "event": {"type": "message_start", "message": {"id": "msg_s"}}})
    emit({"type": "stream_event", "session_id": session, "parent_tool_use_id": None, "event": {"type": "content_block_start", "index": 0, "content_block": {"type": "text", "text": ""}}})
    for i in range(0, len(text), 8):
        emit({"type": "stream_event", "session_id": session, "parent_tool_use_id": None,
              "event": {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": text[i:i + 8]}}})
        time.sleep(float(os.environ.get("IA_FAKE_CLAUDE_STREAM_SLEEP", "0.02")))
emit({
    "type": "assistant",
    "session_id": session,
    "uuid": str(uuid.uuid4()),
    "parent_tool_use_id": None,
    "message": {"id": "msg_" + uuid.uuid4().hex, "role": "assistant", "model": model, "content": [{"type": "text", "text": text}],
                "usage": {"input_tokens": 1, "output_tokens": 1}},
})
subtype = os.environ.get("IA_FAKE_CLAUDE_RESULT", "success")
total = float(os.environ.get("IA_FAKE_CLAUDE_COST", "0"))
if total and log:
    costs = os.path.join(os.path.dirname(log), "fake-claude-costs.json")
    try:
        with open(costs) as f:
            sessions = json.load(f)
    except (OSError, ValueError):
        sessions = {}
    total += sessions.get(session, 0)
    sessions[session] = total
    with open(costs, "w") as f:
        json.dump(sessions, f)
emit({
    "type": "result",
    "subtype": subtype,
    "is_error": subtype != "success",
    "result": text,
    "session_id": session,
    "duration_ms": 1,
    "num_turns": 1,
    "total_cost_usd": total,
    "modelUsage": {model: {"inputTokens": 1, "outputTokens": 1, "costUSD": total}} if total else {},
})
sys.exit(int(os.environ.get("IA_FAKE_CLAUDE_EXIT", "0")))
