#!/usr/bin/env python3
"""Calls to a test server's API (scripts/test-server.sh), so scripts don't each rewrite them.

  ia-api [--env FILE] get|post|patch|delete <path> [json]   # path with or without /api
  ia-api task <task>                                       # GET /api/tasks/<id>
  ia-api new-task <title> [json]                           # in $IA_TEST_PROJECT (--seed)
  ia-api start <task>                                      # start its agent, as the board does
  ia-api send <task> <text>                                # message the task's agent
  ia-api pending [<task>]                                  # pending permission prompts
  ia-api approve-all [<task>] [--deny-pattern REGEX]
  ia-api wait-idle <task> [--timeout SECS] [--approve [--deny-pattern REGEX]] [--grace SECS]
  ia-api thread <task> [--limit N | --before I [--limit N] | --events [--after SEQ]] [--brief]

A <task> is an id, or a key like TES-3 (looked up in $IA_TEST_PROJECT), S-3 or G-3 (a scratch or
group task, in $IA_TEST_PROFILE, or in any profile without one), here and in a path's
/tasks/<task>. The server comes from --env FILE, $IA_TEST_ENV, $IA_TEST_URL and $IA_TEST_TOKEN, or the worktree's .ia-test-env (the
latest test-server.sh start), in that order. It has to be a test server on 127.0.0.1 (not port
7878) or a server that hands out its token (`--open-token`, as PR previews do), so never the live
board. Responses are printed as JSON; an HTTP error exits 1 with the error body on stderr.

`approve-all` allows every pending prompt, denying those whose tool name or input matches
--deny-pattern; a prompt answered meanwhile (409) is reported, any other HTTP error exits 1.
`wait-idle` polls until the task's agent isn't running (or merging), then prints
{status, running, attention_reason, pending_permissions, last_message}. It exits 0 when idle,
2 when the task needs attention (a pending prompt, which --approve answers instead, or a run or
merge that ended in needs_attention) and 124 on timeout (default 300s, --approve included). If no run is going when it
starts, it waits --grace seconds (default 5) for one to start first, since a run can take a
moment to start (a task's title is generated before its run starts, for example).

`thread` reads a task's thread kept as items (API 114, docs/threads-api.md): the whole snapshot,
the window of its last --limit items, the page of items before index --before, or (--events) its
saved events after --after, every page of them (exiting 3 if the log no longer goes back that far).
--brief prints a line for each item (and request, or event) instead of the JSON.
"""
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def die(msg, code=1):
    print(f"ia-api: {msg}", file=sys.stderr)
    sys.exit(code)


def read_env(path):
    env = {}
    try:
        with open(path) as f:
            for line in f:
                m = re.match(r"\s*(?:export\s+)?(IA_TEST_\w+)=(.*)$", line)
                if m:
                    env[m.group(1)] = m.group(2).strip().strip("'\"")
    except OSError as e:
        die(f"can't read {path}: {e.strerror} (is the test server stopped?)")
    return env


def load_env(path):
    if path:
        return read_env(path)
    if os.environ.get("IA_TEST_ENV"):
        return read_env(os.environ["IA_TEST_ENV"])
    if os.environ.get("IA_TEST_URL") and os.environ.get("IA_TEST_TOKEN"):
        return {k: v for k, v in os.environ.items() if k.startswith("IA_TEST_")}
    latest = os.path.join(ROOT, ".ia-test-env")
    if os.path.lexists(latest):
        return read_env(latest)
    die("no test server: start one with scripts/test-server.sh, or pass --env <data dir>/env")


class Api:
    def __init__(self, env):
        self.env = env
        self.url = env.get("IA_TEST_URL", "").rstrip("/")
        self.token = env.get("IA_TEST_TOKEN", "")
        if not self.url or not self.token:
            die("the env has no IA_TEST_URL or IA_TEST_TOKEN")
        # Test servers and previews only: never the live board, a hub or a linked host.
        host = urllib.parse.urlparse(self.url)
        if host.port == 7878:
            die(f"{self.url} is the live board, not a test server")
        if host.hostname not in ("127.0.0.1", "localhost", "::1") and not self.hands_out_token():
            die(f"{self.url} isn't a test server or a preview: only test servers on 127.0.0.1 and servers started with --open-token are allowed")

    def hands_out_token(self):
        """Whether the server gives its token to anyone (`--open-token`), as previews do and the live board and hubs never do."""
        try:
            with urllib.request.urlopen(self.url + "/api/open-token", timeout=30) as r:
                body = json.loads(r.read().decode())
        except urllib.error.HTTPError:
            return False
        except urllib.error.URLError as e:
            die(f"{self.url}: {e.reason} (is the server running?)")
        except ValueError:  # the UI's index.html: there's no such route
            return False
        return isinstance(body, dict) and isinstance(body.get("token"), str)

    def call(self, method, path, body=None, conflict_ok=False):
        """The response's JSON. An HTTP error exits, except that with `conflict_ok` a 409 comes back
        as {"error": …}."""
        path = path if path.startswith("/") else "/" + path
        if not path.startswith("/api/"):
            path = "/api" + path
        # /tasks/TES-3/… takes a key too.
        path = re.sub(r"^/api/tasks/([A-Za-z][A-Za-z0-9]*-\d+)(?=/|$|\?)", lambda m: "/api/tasks/" + self.task_id(m.group(1)), path)
        data = None if body is None else json.dumps(body).encode()
        req = urllib.request.Request(self.url + path, data=data, method=method.upper())
        req.add_header("Authorization", f"Bearer {self.token}")
        if data is not None:
            req.add_header("Content-Type", "application/json")
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                text = r.read().decode()
                ctype = r.headers.get("Content-Type", "")
        except urllib.error.HTTPError as e:
            msg = f"{method.upper()} {path}: HTTP {e.code}: {e.read().decode().strip()}"
            if conflict_ok and e.code == 409:
                return {"error": msg}
            die(msg)
        except urllib.error.URLError as e:
            die(f"{method.upper()} {path}: {e.reason} (is the test server running?)")
        if "text/html" in ctype:
            die(f"{method.upper()} {path}: no such API route (the server answered with the UI's index.html)")
        return json.loads(text) if text.strip() else None

    def task_id(self, ref):
        """An id, or a key: like TES-3 in $IA_TEST_PROJECT, or S-3 (a scratch task) or G-3 (a group task) in
        $IA_TEST_PROFILE, or in any profile without one."""
        m = re.fullmatch(r"([A-Za-z][A-Za-z0-9]*)-(\d+)", ref)
        if not m:
            return ref
        prefix, number = m.group(1).upper(), int(m.group(2))
        if prefix in ("S", "G"):
            # Tasks outside a project (runner::key_prefix): a profile's tasks list has them, with project_id null.
            profile = self.env.get("IA_TEST_PROFILE")
            profiles = [profile] if profile else [p["id"] for p in self.call("get", "/profiles")]
            found = [
                t["id"]
                for p in profiles
                for t in self.call("get", f"/profiles/{p}/tasks")
                if not t.get("project_id") and t["number"] == number and (bool(t.get("group_name")) if prefix == "G" else t.get("task_type") == "scratch" and not t.get("group_name"))
            ]
            if len(found) > 1:
                die(f"{ref} is in more than one profile: set IA_TEST_PROFILE, or use the task id")
            if not found:
                die(f"no task {ref}" + (f" in profile {profile}" if profile else ""))
            return found[0]
        project = self.env.get("IA_TEST_PROJECT")
        if not project:
            die(f"{ref} looks like a key, but there's no IA_TEST_PROJECT (start with --seed, or use the task id)")
        p = self.call("get", f"/projects/{project}")
        if prefix not in [k.upper() for k in [p["key"], *p.get("former_keys", [])]]:
            die(f"{ref} isn't a key of project {p['key']} ($IA_TEST_PROJECT)")
        for t in self.call("get", f"/projects/{project}/tasks"):
            if t["number"] == number:
                return t["id"]
        die(f"no task {ref} in project {p['key']}")

    def pending(self, task=None):
        q = f"?task_id={urllib.parse.quote(self.task_id(task))}" if task else ""
        return self.call("get", "/permissions" + q)

    def approve_all(self, task=None, deny_pattern=None):
        done = []
        for p in self.pending(task):
            text = p["tool_name"] + " " + json.dumps(p["input"])
            decision = "deny" if deny_pattern and re.search(deny_pattern, text) else "allow"
            # A prompt answered or expired meanwhile is a 409, not a reason to stop.
            r = self.call("post", f"/permissions/{p['id']}", {"decision": decision}, conflict_ok=True)
            done.append({"id": p["id"], "task_id": p["task_id"], "tool_name": p["tool_name"], "input": p["input"], "decision": decision,
                         "status": r.get("status") or r.get("error")})
        return done


def take(args, flag, default=None, has_value=True):
    if flag not in args:
        return default
    i = args.index(flag)
    if not has_value:
        del args[i]
        return True
    if i + 1 >= len(args):
        die(f"{flag} needs a value", 2)
    v = args[i + 1]
    del args[i:i + 2]
    return v


def show(v):
    print(json.dumps(v, indent=2))


def summary(api, info):
    t = info["task"]
    return {"id": t["id"], "status": t["status"], "running": t["running"], "attention_reason": t.get("attention_reason"),
            "pending_permissions": info["pending_permissions"], "last_message": info.get("last_message")}


def wait_idle(api, ref, timeout, grace, approve, deny_pattern):
    tid = api.task_id(ref)
    start = time.monotonic()
    first = api.call("get", f"/tasks/{tid}")
    # A merge that needs the user keeps `merging` set, with the run over.
    started = first["task"]["running"] or first["task"].get("merging")
    run0 = first["task"].get("run_started_at")
    while True:
        info = api.call("get", f"/tasks/{tid}")
        t = info["task"]
        elapsed = time.monotonic() - start
        if t.get("run_started_at") != run0 or t["running"] or t.get("merging"):
            started = True
        pending = info["pending_permissions"]
        if pending and not approve:
            show(summary(api, info) | {"pending": api.pending(tid)})
            return 2
        attention = not t["running"] and t["status"] == "needs_attention"
        idle = not t["running"] and not t.get("merging")
        if not pending and (attention or idle) and (started or elapsed >= grace):
            show(summary(api, info))
            return 2 if attention else 0
        # Checked on every round, so prompts that keep coming don't hold it past the deadline.
        if elapsed >= timeout:
            show(summary(api, info))
            print(f"ia-api: timed out after {timeout:g}s", file=sys.stderr)
            return 124
        if pending:
            for d in api.approve_all(tid, deny_pattern):
                print(f"ia-api: {d['decision']} {d['tool_name']} {json.dumps(d['input'])[:200]}: {d['status']}", file=sys.stderr)
            time.sleep(0.5)
            continue
        time.sleep(1)


def clip(text, n=100):
    text = " ".join(str(text).split())
    return text if len(text) <= n else text[:n - 1] + "…"


def brief_item(item):
    """A line for an item: its type and id, then what it says."""
    t = item.get("type")
    what = item.get("text") or item.get("title") or item.get("summary") or item.get("command") or item.get("name") or ""
    if t == "tool_call":
        what = f"{item.get('kind', '?')} {item.get('status', '?')}: {item.get('title') or item.get('command') or item.get('name', '')}"
    elif t == "turn_result":
        what = "ok" if item.get("ok") else ("interrupted" if item.get("interrupted") else f"error {item.get('error', '')}")
    parent = f" (in {item['parent_id']})" if item.get("parent_id") else ""
    return f"{t} {item.get('id')}{parent}: {clip(what)}"


def brief_request(r):
    res = r.get("resolution")
    state = "open" if res is None else res.get("outcome")
    what = r.get("title") or r.get("name") or " / ".join(q.get("question", "") for q in r.get("questions", [])) or r.get("plan", "")
    return f"request {r.get('type')} {r.get('id')} [{state}]: {clip(what)}"


def brief(v):
    """Lines for a snapshot, window or page (with each item's index in the thread), or a list of events."""
    if isinstance(v, list):
        out = []
        for e in v:
            detail = e.get("item", {}).get("id") or e.get("item_id") or e.get("request_id") or e.get("turn_id") or (e.get("request") or {}).get("id") \
                or (e.get("thread") or {}).get("status") or ""
            out.append(f"{e.get('seq')} {e.get('type')} {detail}")
        return out
    context = v.get("context") or []
    items = v.get("items", [])
    start = v.get("start") or 0
    t = v.get("thread")
    out = [f"thread {t['id']} {t['status']} seq {v.get('seq')}" if t else f"page of {v.get('thread_id')} seq {v.get('seq')}"]
    for i, item in enumerate(items):
        index = context[i] if i < len(context) else start + i - len(context)
        out.append(f"{index:>4} {brief_item(item)}")
    out += [brief_request(r) for r in v.get("requests", [])]
    return out


def thread(api, ref, args):
    tid = api.task_id(ref)
    limit, before, after = take(args, "--limit"), take(args, "--before"), take(args, "--after")
    events, short = take(args, "--events", False, has_value=False), take(args, "--brief", False, has_value=False)
    if args or (events and (limit or before)) or (after and not events):
        die("usage: ia-api thread <task> [--limit N | --before I [--limit N] | --events [--after SEQ]] [--brief]", 2)
    if events:
        out, seq = [], int(after or 0)
        while True:
            got = api.call("get", f"/tasks/{tid}/thread/events?after={seq}")
            if got.get("resync"):
                die(f"the thread's log doesn't go back to seq {seq} (its last is {got['seq']}): read the thread instead", 3)
            out += got["events"]
            # `seq` goes past event types the host doesn't know, which aren't in `events`.
            nxt = got.get("seq", got["events"][-1]["seq"] if got["events"] else seq)
            if not got["more"] or nxt <= seq:
                break
            seq = nxt
    elif before is not None:
        out = api.call("get", f"/tasks/{tid}/thread/items?before={int(before)}" + (f"&limit={int(limit)}" if limit else ""))
    else:
        out = api.call("get", f"/tasks/{tid}/thread" + (f"?limit={int(limit)}" if limit else ""))
    if short:
        print("\n".join(brief(out)))
    else:
        show(out)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    api = Api(load_env(take(args, "--env")))
    cmd, rest = args[0], args[1:]
    if cmd in ("get", "post", "patch", "put", "delete"):
        if not rest:
            die(f"usage: ia-api {cmd} <path> [json]", 2)
        body = None
        if len(rest) > 1:
            try:
                body = json.loads(rest[1])
            except ValueError as e:
                die(f"the body isn't JSON: {e}", 2)
        elif cmd in ("post", "patch", "put"):
            body = {}
        show(api.call(cmd, rest[0], body))
    elif cmd == "env":
        for k, v in sorted(api.env.items()):
            print(f"export {k}={v}")
    elif cmd == "task" and len(rest) == 1:
        show(api.call("get", f"/tasks/{api.task_id(rest[0])}"))
    elif cmd == "new-task" and len(rest) in (1, 2):
        project = api.env.get("IA_TEST_PROJECT") or die("no IA_TEST_PROJECT (start the server with --seed)")
        body = {"title": rest[0]} | (json.loads(rest[1]) if len(rest) == 2 else {})
        show(api.call("post", f"/projects/{project}/tasks", body))
    elif cmd == "start" and len(rest) == 1:
        # Moving a task to in_progress doesn't start it: the board then sends an empty message.
        tid = api.task_id(rest[0])
        if api.call("get", f"/tasks/{tid}")["task"]["status"] in ("todo", "backlog"):
            api.call("patch", f"/tasks/{tid}", {"status": "in_progress"})
        show(api.call("post", f"/tasks/{tid}/messages", {"text": ""}))
    elif cmd == "send" and len(rest) == 2:
        show(api.call("post", f"/tasks/{api.task_id(rest[0])}/messages", {"text": rest[1]}))
    elif cmd == "pending" and len(rest) <= 1:
        show(api.pending(rest[0] if rest else None))
    elif cmd == "approve-all":
        deny = take(rest, "--deny-pattern")
        if len(rest) > 1:
            die("usage: ia-api approve-all [<task>] [--deny-pattern REGEX]", 2)
        show(api.approve_all(rest[0] if rest else None, deny))
    elif cmd == "wait-idle":
        timeout = float(take(rest, "--timeout", 300))
        grace = float(take(rest, "--grace", 5))
        deny = take(rest, "--deny-pattern")
        approve = take(rest, "--approve", False, has_value=False)
        if len(rest) != 1:
            die("usage: ia-api wait-idle <task> [--timeout SECS] [--approve [--deny-pattern REGEX]] [--grace SECS]", 2)
        return wait_idle(api, rest[0], timeout, grace, approve, deny)
    elif cmd == "thread" and rest:
        thread(api, rest[0], rest[1:])
    else:
        die(f"unknown command or wrong arguments: {' '.join(args)} (see ia-api --help)", 2)
    return 0


if __name__ == "__main__":
    sys.exit(main())
