{
  "expo": {
    "name": "Huntaway",
    "slug": "huntaway",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nz.net.ivan.huntaway",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0f13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "nz.net.ivan.huntaway"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#8b7cf6"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Huntaway uses the camera to scan a board's pairing QR code and to take photos for tasks.",
          "microphonePermission": "Huntaway uses the microphone to dictate messages and record voice notes for your assistant and tasks.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Huntaway attaches the photos you pick to your tasks.",
          "cameraPermission": "Huntaway uses the camera to take photos for tasks.",
          "microphonePermission": "Huntaway uses the microphone to dictate messages and record voice notes for your assistant and tasks."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Huntaway uses the microphone to dictate messages and record voice notes for your assistant and tasks.",
          "speechRecognitionPermission": "Huntaway turns what you say into text for your messages, on this phone where it can."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "Huntaway Share",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 5
          },
          "androidIntentFilters": [
            "text/*",
            "image/*",
            "audio/*",
            "application/pdf"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0f0f13"
        }
      ]
    ],
    "scheme": "huntaway",
    "backgroundColor": "#0f0f13",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "HuntawayShare",
                  "bundleIdentifier": "nz.net.ivan.huntaway.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.nz.net.ivan.huntaway"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
