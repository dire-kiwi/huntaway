{
  "name": "huntaway-app",
  "version": "0.1.0",
  "private": true,
  "description": "Huntaway desktop + web UI",
  "homepage": "https://github.com/dire-kiwi/huntaway",
  "license": "MIT",
  "author": "Ivan Meredith",
  "type": "module",
  "main": "electron/boot.cjs",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test",
    "test:ui": "pnpm run build && vp test --config tests/ui/vitest.config.ts",
    "electron": "electron .",
    "electron:dev": "IA_DEV_URL=http://localhost:5173 electron .",
    "dist": "pnpm run build && (cd ../.. && cargo build --release --locked -p ia-shim) && ../../scripts/package-server.sh ../../release-server && electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huntaway/client": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.2.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12"
  },
  "build": {
    "appId": "nz.net.ivan.huntaway",
    "productName": "Huntaway",
    "files": [
      "electron/**",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../../release-server",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "huntaway-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "executableName": "huntaway-desktop",
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Kanban board for Claude Code and Codex agents",
      "description": "A kanban board for orchestrating Claude Code and Codex agents.",
      "maintainer": "Huntaway <https://github.com/dire-kiwi/huntaway>"
    },
    "pacman": {
      "packageName": "huntaway",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "libsecret",
        "at-spi2-core",
        "xdg-utils",
        "git"
      ],
      "fpm": [
        "--description",
        "Kanban board for Claude Code and Codex agents"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "directories": {
      "output": "release"
    }
  },
  "desktopName": "huntaway-app.desktop"
}
