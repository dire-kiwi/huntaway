{
  "name": "huntaway-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The huntaway server, in TypeScript (ported from the Rust server, removed in HA-179). Runs on Node 24+ with no build step.",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts serve",
    "typecheck": "tsrs --noEmit -p .",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=8 --test-timeout=60000 'src/**/*.test.ts' 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "tsrs": "0.22.0-ts7.1.0-beta"
  }
}
