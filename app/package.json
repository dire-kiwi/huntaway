{
  "name": "huntaway-app",
  "private": true,
  "version": "0.1.0",
  "description": "Huntaway desktop + web UI",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "huntaway-app.desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "npm run build && node --experimental-strip-types --test --test-concurrency=1 tests/ui/*.test.mjs",
    "electron": "electron .",
    "electron:dev": "IA_DEV_URL=http://localhost:5173 electron ."
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
