{
  "name": "huntaway-app",
  "private": true,
  "version": "0.1.0",
  "description": "Huntaway desktop + web UI",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "huntaway-app.desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "npm run build && node --experimental-strip-types --test --test-concurrency=1 tests/ui/*.test.mjs",
    "electron": "electron .",
    "electron:dev": "IA_DEV_URL=http://localhost:5173 electron .",
    "dist": "npm run build && (cd ../server && cargo build --release --locked) && electron-builder --publish never"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "author": "Ivan Meredith",
  "homepage": "https://github.com/dire-kiwi/huntaway",
  "build": {
    "appId": "nz.net.ivan.huntaway",
    "productName": "Huntaway",
    "files": [
      "electron/**",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../server/target/release/huntaway",
        "to": "huntaway"
      },
      {
        "from": "../server/target/release/ia-shim",
        "to": "ia-shim"
      },
      {
        "from": "dist",
        "to": "ui"
      }
    ],
    "artifactName": "huntaway-${version}-${os}-${arch}.${ext}",
    "linux": {
      "target": [
        "AppImage",
        "pacman"
      ],
      "executableName": "huntaway-desktop",
      "category": "Development",
      "icon": "build/icon.png",
      "synopsis": "Kanban board for Claude Code and Codex agents",
      "description": "A kanban board for orchestrating Claude Code and Codex agents.",
      "maintainer": "Huntaway <https://github.com/dire-kiwi/huntaway>"
    },
    "pacman": {
      "packageName": "huntaway",
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst",
        "libnotify",
        "libsecret",
        "at-spi2-core",
        "xdg-utils",
        "git"
      ],
      "fpm": [
        "--description",
        "Kanban board for Claude Code and Codex agents"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    },
    "directories": {
      "output": "release"
    }
  }
}
